<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudyFlowSA.ViewModels"
             x:Class="StudyFlowSA.Views.AddEditSubjectPage"
             x:DataType="vm:AddEditSubjectViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Subject name" FontSize="14" TextColor="#1B3358" />
            <Entry Text="{Binding Name}" Placeholder="e.g. Mathematics" />

            <Label Text="Color" FontSize="14" TextColor="#1B3358" Margin="0,10,0,0" />
            <CollectionView ItemsSource="{Binding ColorOptions}"
                             SelectionMode="Single"
                             SelectedItem="{Binding SelectedColor}"
                             HeightRequest="60">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Frame BackgroundColor="{Binding .}"
                               WidthRequest="44"
                               HeightRequest="44"
                               CornerRadius="22"
                               Padding="0"
                               HasShadow="False" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Text="Save"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#1B3358"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,10,0,0" />

            <Button Text="Cancel"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#1B3358" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>