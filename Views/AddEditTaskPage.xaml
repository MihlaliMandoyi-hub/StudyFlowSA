<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudyFlowSA.ViewModels"
             xmlns:models="clr-namespace:StudyFlowSA.Models"
             x:Class="StudyFlowSA.Views.AddEditTaskPage"
             x:DataType="vm:AddEditTaskViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">

            <Label Text="Title" FontSize="14" TextColor="#1B3358" />
            <Entry Text="{Binding Title}" Placeholder="e.g. Life Sciences assignment" />

            <Label Text="Subject" FontSize="14" TextColor="#1B3358" />
            <Picker ItemsSource="{Binding Subjects}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedSubject}"
                    Title="Select subject" />

            <Label Text="Category" FontSize="14" TextColor="#1B3358" />
            <Picker ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" />

            <Label Text="Due date" FontSize="14" TextColor="#1B3358" />
            <DatePicker Date="{Binding DueDate}" />

            <Label Text="Priority" FontSize="14" TextColor="#1B3358" />
            <Picker ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding SelectedPriority}" />

            <Label Text="Estimated study time (minutes)" FontSize="14" TextColor="#1B3358" />
            <Entry Text="{Binding EstimatedMinutesText}" Keyboard="Numeric" />

            <Label Text="Notes" FontSize="14" TextColor="#1B3358" />
            <Editor Text="{Binding Notes}" HeightRequest="80" Placeholder="Optional notes..." />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Text="Save"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#1B3358"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,10,0,0" />

            <Button Text="Cancel"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#1B3358" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>