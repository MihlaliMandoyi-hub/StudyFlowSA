<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudyFlowSA.ViewModels"
             x:Class="StudyFlowSA.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="Home"
             BackgroundColor="#F5F5F0">

    <Grid RowDefinitions="*,Auto">

        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadDashboardCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="20" Spacing="18">

                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <Label Grid.Column="0"
                               Text="{Binding Greeting}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#1B3358"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Subjects"
                                FontSize="12"
                                BackgroundColor="Transparent"
                                TextColor="#1B3358"
                                Command="{Binding GoToSubjectsCommand}" />
                        <Button Grid.Column="2"
                                Text="⚙"
                                FontSize="18"
                                BackgroundColor="Transparent"
                                TextColor="#1B3358"
                                Command="{Binding GoToSettingsCommand}" />
                        <Button Grid.Column="3"
                                Text="⏱"
                                FontSize="18"
                                BackgroundColor="Transparent"
                                TextColor="#1B3358"
                                Clicked="OnGoToTimerClicked" />
                    </Grid>

                    <Frame IsVisible="{Binding HasNextDeadline}"
                           BackgroundColor="#1B3358"
                           CornerRadius="14"
                           Padding="18"
                           HasShadow="False">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Next deadline" FontSize="12" TextColor="#D9A441" />
                            <Label Text="{Binding NextDeadline.Task.Title}" FontSize="18" FontAttributes="Bold" TextColor="White" />
                            <Label Text="{Binding NextDeadline.SubjectName}" FontSize="13" TextColor="White" Opacity="0.8" />
                            <Label Text="{Binding NextDeadline.DueDateDisplay}" FontSize="13" TextColor="#D9A441" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame IsVisible="{Binding HasNextDeadline, Converter={StaticResource InvertedBoolConverter}}"
                           BackgroundColor="White"
                           CornerRadius="14"
                           Padding="18"
                           HasShadow="False">
                        <Label Text="No upcoming deadlines — you're all caught up!" TextColor="Gray" HorizontalTextAlignment="Center" />
                    </Frame>

                    <Frame BackgroundColor="White" CornerRadius="14" Padding="18" HasShadow="False">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="This week's progress" FontSize="14" FontAttributes="Bold" TextColor="#1B3358" />
                            <Grid ColumnDefinitions="*,*">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding CompletionRatePercent, StringFormat='{0}%'}" FontSize="24" FontAttributes="Bold" TextColor="#3B6D11" />
                                    <Label Text="Tasks completed" FontSize="11" TextColor="Gray" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding TotalMinutesStudiedThisWeek, StringFormat='{0} min'}" FontSize="24" FontAttributes="Bold" TextColor="#D9A441" />
                                    <Label Text="Studied this week" FontSize="11" TextColor="Gray" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                    <Label Text="Today's tasks" FontSize="16" FontAttributes="Bold" TextColor="#1B3358" />

                    <CollectionView ItemsSource="{Binding TodayTasks}"
                                     IsVisible="{Binding HasTodayTasks}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TaskListItem">
                                <Frame CornerRadius="12" Padding="14" Margin="0,0,0,8" HasShadow="False" BackgroundColor="White">
                                    <Grid ColumnDefinitions="6,*" ColumnSpacing="12">
                                        <BoxView Grid.Column="0" Color="{Binding SubjectColorHex}" CornerRadius="3" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Task.Title}" FontAttributes="Bold" FontSize="15" TextColor="#1B3358" />
                                            <Label Text="{Binding SubjectName}" FontSize="12" TextColor="Gray" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Frame IsVisible="{Binding HasTodayTasks, Converter={StaticResource InvertedBoolConverter}}"
                           BackgroundColor="White"
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="False">
                        <Label Text="Nothing due today. Nice work!" TextColor="Gray" HorizontalTextAlignment="Center" />
                    </Frame>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Button Grid.Row="1"
                Text="Add task"
                Command="{Binding GoToAddTaskCommand}"
                BackgroundColor="#D9A441"
                TextColor="#1B3358"
                FontAttributes="Bold"
                CornerRadius="10"
                Margin="16"
                HeightRequest="50" />

    </Grid>
</ContentPage>