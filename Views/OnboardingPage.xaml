<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudyFlowSA.ViewModels"
             x:Class="StudyFlowSA.Views.OnboardingPage"
             x:DataType="vm:OnboardingViewModel"
             BackgroundColor="#1B3358">

    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="20" VerticalOptions="Center">

            <Label Text="StudyFlow SA"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />

            <Label Text="Organise your subjects, tasks, and study time — even offline."
                   FontSize="15"
                   TextColor="#D9A441"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,20" />

            <Frame BackgroundColor="White" CornerRadius="16" Padding="24" HasShadow="False">
                <VerticalStackLayout Spacing="16">

                    <Label Text="What's your name?" FontSize="14" TextColor="#1B3358" />
                    <Entry Text="{Binding LearnerName}"
                           Placeholder="e.g. Mihlali"
                           PlaceholderColor="Gray" />

                    <Label Text="What grade or year are you in?" FontSize="14" TextColor="#1B3358" />
                    <Picker ItemsSource="{Binding GradeOptions}"
                            SelectedItem="{Binding Grade}"
                            Title="Select grade or year" />

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="Red"
                           FontSize="13"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                    <Button Text="Get started"
                            Command="{Binding GetStartedCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="#D9A441"
                            TextColor="#1B3358"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="50" />

                    <Button Text="Skip for now"
                            Command="{Binding SkipCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#1B3358"
                            FontSize="13" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#1B3358" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>