<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudyFlowSA.ViewModels"
             xmlns:models="clr-namespace:StudyFlowSA.Models"
             x:Class="StudyFlowSA.Views.SubjectsPage"
             x:DataType="vm:SubjectsViewModel"
             Title="Subjects">

    <Grid RowDefinitions="*,Auto">

        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadSubjectsCommand}">
            <Grid>
                <CollectionView ItemsSource="{Binding Subjects}"
                                 IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}"
                                 Margin="16">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Subject">
                            <Frame CornerRadius="12" Padding="16" Margin="0,0,0,10" HasShadow="False"
                                   BackgroundColor="{Binding ColorHex}">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding Name}"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           VerticalOptions="Center" />

                                    <Button Grid.Column="1"
                                            Text="Edit"
                                            BackgroundColor="Transparent"
                                            TextColor="White"
                                            FontSize="13"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SubjectsViewModel}}, Path=EditSubjectCommand}"
                                            CommandParameter="{Binding .}" />

                                    <Button Grid.Column="2"
                                            Text="Delete"
                                            BackgroundColor="Transparent"
                                            TextColor="White"
                                            FontSize="13"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SubjectsViewModel}}, Path=DeleteSubjectCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                      VerticalOptions="Center"
                                      HorizontalOptions="Center"
                                      Spacing="8">
                    <Label Text="No subjects yet" FontSize="18" HorizontalOptions="Center" TextColor="Gray" />
                    <Label Text="Tap 'Add subject' below to create your first one." FontSize="13" HorizontalOptions="Center" TextColor="Gray" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </RefreshView>

        <Button Grid.Row="1"
                Text="Add subject"
                Command="{Binding AddSubjectCommand}"
                BackgroundColor="#D9A441"
                TextColor="#1B3358"
                FontAttributes="Bold"
                CornerRadius="10"
                Margin="16"
                HeightRequest="50" />

    </Grid>
</ContentPage>