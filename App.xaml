<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:StudyFlowSA.Services"
             x:Class="StudyFlowSA.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <conv:OverdueToColorConverter x:Key="OverdueToColorConverter" />
            <conv:FractionToBarWidthConverter x:Key="FractionToBarWidthConverter" />
            <conv:TodayToBorderColorConverter x:Key="TodayToBorderColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>